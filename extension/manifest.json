{
  "manifest_version": 3,
  "name": "AR Locals – Bookwhen Check",
  "version": "1.2.1",
  "description": "Lets the Atlantic Reach Locals desk check a member's Bookwhen Locals status using this browser's Bookwhen login.",
  "permissions": ["tabs", "scripting"],
  "host_permissions": ["https://atlanticreach.bookwhen.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [{
    "matches": ["https://sonjamesg.github.io/ar-locals-scan/*", "http://localhost/*"],
    "js": ["desk-bridge.js"],
    "run_at": "document_start"
  }]
}
